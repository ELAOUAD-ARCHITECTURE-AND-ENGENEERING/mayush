APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=homestead
DB_USERNAME=homestead
DB_PASSWORD=secret

BROADCAST_DRIVER=null
CACHE_DRIVER=file
QUEUE_CONNECTION=redis
IMAGE_OPTIMIZATION_QUEUE=images
IMAGE_OPTIMIZATION_AUDIT_LIMIT=500
IMAGE_OPTIMIZATION_RECIPE_VERSION=2
STOREFRONT_ASSET_PROFILE_ENABLED=true
STOREFRONT_DEFER_MARKETING=true
STOREFRONT_FRAGMENT_CACHE=true
STOREFRONT_SERVER_TIMING=false
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=""
REDIS_PORT=6379
REDIS_CLIENT=phpredis 
REDIS_QUEUE_DB=1

MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Notification Center v2
# Start with all notification flags disabled. Enable the inbox and outbound/live
# channels individually after their production checks pass.
NOTIFICATIONS_V2_ENABLED=false
NOTIFICATION_BROADCASTING_ENABLED=false
NOTIFICATION_SMS_ENABLED=false
FCM_V1_ENABLED=false
NOTIFICATION_DELIVERY_WEBHOOK_SECRET=

# Laravel Reverb: bind the server privately and expose it through HTTPS/WSS.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080
REVERB_ALLOWED_ORIGINS=
REVERB_SCALING_ENABLED=false

# Firebase Cloud Messaging HTTP v1. Keep the JSON file outside the repository.
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_PATH=

CMI_CLIENT_ID=
CMI_STORE_KEY=
CMI_STORE_TYPE=3d_pay_hosting

CMI_MERCHANT_ID=
CMI_SECRET_KEY=
CMI_GATEWAY_URL=https://testpayment.cmi.co.ma/fim/est3Dgate
CMI_OK_URL=
CMI_FAIL_URL=
CMI_CALLBACK_URL=
CMI_ALLOWED_IPS=

ONESSTA_ENABLED=false
ONESSTA_MODE=live
ONESSTA_BASE_URL=https://api.onessta.com/api/v1
ONESSTA_TOKEN=
ONESSTA_API_KEY=
ONESSTA_CLIENT_ID=
ONESSTA_QUEUE_CONNECTION=redis
ONESSTA_CREATE_SHIPMENT_QUEUE_CONNECTION=redis
ONESSTA_QUEUE_NAME=shipping
ONESSTA_WEBHOOK_ENABLED=true
ONESSTA_WEBHOOK_API_KEY=
ONESSTA_WEBHOOK_SECRET=
ONESSTA_FAIL_ON_SIGNATURE_MISMATCH=true
ONESSTA_POLLING_ENABLED=true
ONESSTA_POLLING_MAX_PARCELS=100

# Mayush Nightwatch Alerting (Disabled by default)
NIGHTWATCH_ENABLED=false
NIGHTWATCH_SLACK_WEBHOOK_URL=
NIGHTWATCH_ALERT_EMAIL=

# Nightwatch Monitoring
NIGHTWATCH_ENABLED=false
NIGHTWATCH_TOKEN=
