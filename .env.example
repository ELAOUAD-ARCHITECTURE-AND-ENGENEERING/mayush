ONESSTA_CREATE_SHIPMENT_QUEUE_CONNECTION=redis
ONESSTA_QUEUE_NAME=shipping
ONESSTA_WEBHOOK_ENABLED=true
ONESSTA_WEBHOOK_API_KEY=
ONESSTA_WEBHOOK_SECRET=
