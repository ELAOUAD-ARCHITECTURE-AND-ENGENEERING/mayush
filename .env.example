OPENROUTER_TRANSLATION_TIMEOUT=90
OPENROUTER_TRANSLATION_MAX_RETRIES=3
OPENROUTER_TRANSLATION_RETRY_AFTER=60
OPENROUTER_TRANSLATION_MAX_PAYLOAD=100000
OPENROUTER_TEMPERATURE=0.1
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENROUTER_EMBEDDING_DIMENSIONS=768
PRODUCT_TRANSLATION_MAX_ITEM_ATTEMPTS=3
PRODUCT_TRANSLATION_CACHE_TTL=2592000
PRODUCT_TRANSLATION_WORKER_TIMEOUT=480

# Mobile system status and update policy
