APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=homestead
DB_USERNAME=homestead
DB_PASSWORD=secret

BROADCAST_DRIVER=null
CACHE_DRIVER=file
QUEUE_CONNECTION=redis
PRODUCT_TRANSLATION_QUEUE=translations
PRODUCT_TRANSLATION_QUEUE_CONNECTION=redis_translations
PRODUCT_TRANSLATION_QUEUE_RETRY_AFTER=600
PRODUCT_TRANSLATION_WORKER_TIMEOUT=480
IMAGE_OPTIMIZATION_QUEUE=images
IMAGE_OPTIMIZATION_AUDIT_LIMIT=500
IMAGE_OPTIMIZATION_RECIPE_VERSION=2
STOREFRONT_ASSET_PROFILE_ENABLED=true
STOREFRONT_DEFER_MARKETING=true
STOREFRONT_FRAGMENT_CACHE=true
STOREFRONT_SERVER_TIMING=false
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=""
REDIS_PORT=6379
REDIS_CLIENT=phpredis 
REDIS_QUEUE_DB=1

MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Notification Center v2
# Start with all notification flags disabled. Enable the inbox and outbound/live
# channels individually after their production checks pass.
NOTIFICATIONS_V2_ENABLED=false
NOTIFICATION_BROADCASTING_ENABLED=false
NOTIFICATION_SMS_ENABLED=false
FCM_V1_ENABLED=false
NOTIFICATION_DELIVERY_WEBHOOK_SECRET=

# Laravel Reverb: bind the server privately and expose it through HTTPS/WSS.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080
REVERB_ALLOWED_ORIGINS=
REVERB_SCALING_ENABLED=false

# Firebase Cloud Messaging HTTP v1. Keep the JSON file outside the repository.
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_PATH=

CMI_CLIENT_ID=
CMI_STORE_KEY=
CMI_STORE_TYPE=3d_pay_hosting

CMI_MERCHANT_ID=
CMI_SECRET_KEY=
