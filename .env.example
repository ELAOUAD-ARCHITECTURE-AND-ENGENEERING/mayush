CMI_FAIL_URL=
CMI_CALLBACK_URL=
CMI_ALLOWED_IPS=

ONESSTA_ENABLED=false
ONESSTA_MODE=live
ONESSTA_BASE_URL=https://api.onessta.com/api/v1
ONESSTA_TOKEN=
