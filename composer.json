{
    "name": "laravel/laravel",
    "description": "The Laravel Framework.",
    "keywords": ["framework", "laravel"],
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.2",
        "aiz-packages/color-code-converter": "dev-main",
        "aiz-packages/combination-generate": "dev-main",
        "anandsiddharth/laravel-paytm-wallet": "^2.0",
        "authorizenet/authorizenet": "^2.0",
        "enshrined/svg-sanitize": "0.22.0",
        "genealabs/laravel-sign-in-with-apple": "^12.0",
        "genealabs/laravel-socialiter": "^12.0",
        "guzzlehttp/guzzle": "^7.5",
        "instamojo/instamojo-php": "^0.4.0",
        "intervention/image": "^2.5",
        "iyzico/iyzipay-php": "^2.0",
        "kingflamez/laravelrave": "dev-master",
        "laracasts/flash": "^3.2",
        "laravel/framework": "^10.0",
        "laravel/horizon": "^5.45",
        "laravel/sanctum": "^3.2",
        "laravel/socialite": "^5.6",
        "laravel/tinker": "^2.8",
        "laravel/ui": "^4.2",
        "lcobucci/jwt": "^4.0",
        "league/flysystem-aws-s3-v3": "^3.12",
        "livewire/livewire": "^4.2",
        "maatwebsite/excel": "^3.1",
        "mehedi-iitdu/core-component-repository": "^2.2",
        "mercadopago/dx-php": "^2.5",
        "mpdf/mpdf": "^8.1",
        "niklasravnsborg/laravel-pdf": "^4.1",
        "paypal/paypal-checkout-sdk": "dev-master",
        "predis/predis": "^2.1",
        "psr/log": "^2.0",
        "razorpay/razorpay": "2.*",
        "rmccue/requests": "^2.0",
        "simplesoftwareio/simple-qrcode": "^4.2",
        "spatie/db-dumper": "^3.3",
        "spatie/laravel-permission": "^5.5",
        "spatie/laravel-sitemap": "^7.3",
        "stevebauman/location": "^7.6",
        "stichoza/google-translate-php": "^5.2",
        "stripe/stripe-php": "^10.5",
        "twilio/sdk": "^6.44",
        "unicodeveloper/laravel-paystack": "^1.0"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.8",
        "barryvdh/laravel-ide-helper": "^2.13",
        "fakerphp/faker": "^1.9.1",
        "laravel/sail": "^1.0.1",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^7.0",
        "phpunit/phpunit": "^10.0",
        "spatie/laravel-ignition": "^2.0"
    },
    "autoload": {
        "classmap": [
            "database/seeds",
            "database/seeders",
            "database/factories"
        ],
        "psr-4": {
            "App\\": "app/",
            "Mayush\\Shipping\\Onessta\\": "packages/mayush/onessta-shipping/src/"
        },
        "files": ["app/Http/Helpers.php"]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Mayush\\Shipping\\Onessta\\Tests\\": "packages/mayush/onessta-shipping/tests/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "packages/mayush/onessta-shipping",
            "options": {"symlink": true}
        }
    ],
    "extra": {
        "laravel": {
            "dont-discover": [
                "barryvdh/laravel-debugbar",
                "barryvdh/laravel-ide-helper",
                "spatie/laravel-ignition"
            ]
        }
    },
    "scripts": {
        "test-prepare": [
            "@php artisan optimize:clear"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan app:patch-vendor --ansi"
        ],
        "preflight": [
            "@php artisan app:preflight-restore"
        ],
        "guardrails": [
            "@php scripts/ci/check-operational-guardrails.php"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "symfony/thanks": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
