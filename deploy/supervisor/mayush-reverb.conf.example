[program:mayush-reverb]
process_name=%(program_name)s
command=/usr/bin/php8.2 /home/mayushdesign/public_html/artisan reverb:start --host=127.0.0.1 --port=8080
directory=/home/mayushdesign/public_html
autostart=true
autorestart=true
stopasgroup=true
killasgroup=true
user=mayushdesign
redirect_stderr=true
stdout_logfile=/home/mayushdesign/public_html/storage/logs/reverb.log
stdout_logfile_maxbytes=20MB
stdout_logfile_backups=5
stopwaitsecs=10
minfds=10000
