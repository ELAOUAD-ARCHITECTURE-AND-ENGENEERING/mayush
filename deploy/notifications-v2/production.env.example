# Copy these keys into the production .env and replace every CHANGE_ME value.
# Never commit the completed production values.

APP_ENV=production
APP_DEBUG=false
APP_URL=https://mayushdesign.com

QUEUE_CONNECTION=redis
# Keep live broadcasting disabled until the Apache WSS path is verified.
BROADCAST_DRIVER=null

# Safe first deployment: persist audit events and the inbox, but keep external
# and live channels disabled until each production check succeeds.
NOTIFICATIONS_V2_ENABLED=false
NOTIFICATION_BROADCASTING_ENABLED=false
NOTIFICATION_SMS_ENABLED=false
FCM_V1_ENABLED=false

# Generate with: openssl rand -hex 32
NOTIFICATION_DELIVERY_WEBHOOK_SECRET=CHANGE_ME

# Generate independent values. Do not reuse application, payment, or webhook
# secrets. REVERB_HOST is a hostname only, without https://.
REVERB_APP_ID=mayush-production
REVERB_APP_KEY=CHANGE_ME
REVERB_APP_SECRET=CHANGE_ME
REVERB_HOST=mayushdesign.com
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080
REVERB_ALLOWED_ORIGINS=https://mayushdesign.com
REVERB_SCALING_ENABLED=false

# Keep the service-account file outside public_html and readable only by the
# application user, for example /home/mayushdesign/secrets/firebase.json.
FCM_PROJECT_ID=CHANGE_ME
FCM_SERVICE_ACCOUNT_PATH=/home/mayushdesign/secrets/firebase.json
