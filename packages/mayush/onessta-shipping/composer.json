{
    "name": "mayush/onessta-shipping",
    "description": "ONESSTA 3PL Shipping integration for Mayush E-Commerce Platform",
    "type": "library",
    "license": "proprietary",
    "authors": [
        {
            "name": "Mayush Development Team"
        }
    ],
    "require": {
        "php": ">=8.1",
        "laravel/framework": ">=10.0",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "mockery/mockery": "^1.6",
        "fakerphp/faker": "^1.23"
    },
    "autoload": {
        "psr-4": {
            "Mayush\\Shipping\\Onessta\\": "src/"
        },
        "files": [
            "tests/helpers/addon_is_activated.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Mayush\\Shipping\\Onessta\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Mayush\\Shipping\\Onessta\\OnesstaShippingServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
